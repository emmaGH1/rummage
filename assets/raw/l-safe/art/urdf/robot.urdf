<?xml version="1.0"?>
<robot name="robot">
  <link name="base">
    <visual>
      <geometry>
        <mesh filename="meshes/base.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <link name="door">
    <visual>
      <geometry>
        <mesh filename="meshes/door.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="door_joint" type="revolute">
    <parent link="base" />
    <child link="door" />
    <origin rpy="0 0 0" xyz="-0.11301300 0.26841648 0.09758200" />
    <axis xyz="-0.01898200 -0.99978400 0.00851600" />
    <limit lower="0.000000" upper="1.570796" effort="10" velocity="1" />
  </joint>
</robot>