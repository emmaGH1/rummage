  </link>
  <link name="door_left">
    <visual>
      <geometry>
        <mesh filename="meshes/door_left.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
