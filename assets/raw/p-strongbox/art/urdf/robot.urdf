<?xml version="1.0"?>
<robot name="robot">
  <link name="chest_body">
    <visual>
      <geometry>
        <mesh filename="meshes/chest_body.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <link name="chest_lid">
    <visual>
      <geometry>
        <mesh filename="meshes/chest_lid.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="chest_lid_joint" type="revolute">
    <parent link="chest_body" />
    <child link="chest_lid" />
    <origin rpy="0 0 0" xyz="0.00069000 0.12941337 -0.07294800" />
    <axis xyz="-0.99999100 -0.00358000 -0.00213300" />
    <limit lower="0.000000" upper="1.570000" effort="10" velocity="1" />
  </joint>
</robot>