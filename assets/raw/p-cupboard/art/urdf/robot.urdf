<?xml version="1.0"?>
<robot name="robot">
  <link name="body">
    <visual>
      <geometry>
        <mesh filename="meshes/body.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <link name="door">
    <visual>
      <geometry>
        <mesh filename="meshes/door.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <link name="drawer">
    <visual>
      <geometry>
        <mesh filename="meshes/drawer.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="door_joint" type="revolute">
    <parent link="body" />
    <child link="door" />
    <origin rpy="0 0 0" xyz="-0.08552400 0.23684900 0.07910600" />
    <axis xyz="-0.01075300 0.99994000 0.00213700" />
    <limit lower="-1.570000" upper="0.000000" effort="10" velocity="1" />
  </joint>
  <joint name="drawer_joint" type="prismatic">
    <parent link="body" />
    <child link="drawer" />
    <origin rpy="0 0 0" xyz="0.00037900 0.09352900 0.00457000" />
    <axis xyz="0.00000000 0.00000000 1.00000000" />
    <limit lower="0.000000" upper="0.119147" effort="10" velocity="1" />
  </joint>
</robot>