<?xml version="1.0"?>
<robot name="robot">
  <link name="chest_base">
    <visual>
      <geometry>
        <mesh filename="meshes/chest_base.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <link name="chest_lid">
    <visual>
      <geometry>
        <mesh filename="meshes/chest_lid.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="chest_lid_joint" type="revolute">
    <parent link="chest_base" />
    <child link="chest_lid" />
    <origin rpy="0 0 0" xyz="-0.00010600 0.17487902 -0.10377600" />
    <axis xyz="-0.99999800 0.00220500 0.00033900" />
    <limit lower="0.000000" upper="1.570000" effort="10" velocity="1" />
  </joint>
</robot>