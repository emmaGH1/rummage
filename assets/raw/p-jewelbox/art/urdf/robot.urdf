<?xml version="1.0"?>
<robot name="robot">
  <link name="body">
    <visual>
      <geometry>
        <mesh filename="meshes/body.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <link name="lid">
    <visual>
      <geometry>
        <mesh filename="meshes/lid.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="lid_joint" type="revolute">
    <parent link="body" />
    <child link="lid" />
    <origin rpy="0 0 0" xyz="0.00147500 0.07434476 -0.04299000" />
    <axis xyz="-0.99996000 -0.00893900 0.00089100" />
    <limit lower="0.000000" upper="1.570000" effort="10" velocity="1" />
  </joint>
</robot>