<?xml version="1.0"?>
<robot name="robot">
  <link name="body">
    <visual>
      <geometry>
        <mesh filename="meshes/body.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <link name="door">
    <visual>
      <geometry>
        <mesh filename="meshes/door.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="door_joint" type="revolute">
    <parent link="body" />
    <child link="door" />
    <origin rpy="0 0 0" xyz="-0.08162000 0.29016801 0.09020000" />
    <axis xyz="-0.00141100 0.99999600 0.00262400" />
    <limit lower="-1.570796" upper="0.000000" effort="10" velocity="1" />
  </joint>
</robot>