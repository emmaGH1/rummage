    <origin rpy="0 0 0" xyz="-0.03923700 0.08142500 0.02574400" />
    <axis xyz="-0.00073600 0.99999700 0.00239100" />
    <limit lower="-1.570796" upper="0.000000" effort="10" velocity="1" />
  </joint>
  <joint name="door_right_joint" type="revolute">
    <parent link="body" />
