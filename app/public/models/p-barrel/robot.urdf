<?xml version="1.0"?>
<robot name="robot">
  <link name="body">
    <visual>
      <geometry>
        <mesh filename="meshes/body.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <link name="lid_top">
    <visual>
      <geometry>
        <mesh filename="meshes/lid_top.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="lid_top_joint" type="revolute">
    <parent link="body" />
    <child link="lid_top" />
    <origin rpy="0 0 0" xyz="-0.00005200 0.34609200 -0.12597400" />
    <axis xyz="-0.99993300 -0.00360500 0.01100700" />
    <limit lower="0.000000" upper="2.094395" effort="10" velocity="1" />
  </joint>
</robot>