<?xml version="1.0"?>
<robot name="robot">
  <link name="chest_body">
    <visual>
      <geometry>
        <mesh filename="meshes/chest_body.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <link name="chest_lid">
    <visual>
      <geometry>
        <mesh filename="meshes/chest_lid.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="chest_lid_joint" type="revolute">
    <parent link="chest_body" />
    <child link="chest_lid" />
    <origin rpy="0 0 0" xyz="-0.06137500 0.15017013 -0.11050300" />
    <axis xyz="-0.99998600 0.00501300 0.00195900" />
    <limit lower="0.000000" upper="2.094000" effort="10" velocity="1" />
  </joint>
</robot>