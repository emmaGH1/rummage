<?xml version="1.0"?>
<robot name="robot">
  <link name="body">
    <visual>
      <geometry>
        <mesh filename="meshes/body.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <link name="lid_front">
    <visual>
      <geometry>
        <mesh filename="meshes/lid_front.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="lid_front_joint" type="revolute">
    <parent link="body" />
    <child link="lid_front" />
    <origin rpy="0 0 0" xyz="-0.00595800 0.14002114 -0.13481800" />
    <axis xyz="-0.99998200 -0.00565900 0.00216000" />
    <limit lower="0.000000" upper="1.570000" effort="10" velocity="1" />
  </joint>
</robot>