<?xml version="1.0"?>
<robot name="robot">
  <link name="base">
    <visual>
      <geometry>
        <mesh filename="meshes/base.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <link name="cover_front">
    <visual>
      <geometry>
        <mesh filename="meshes/cover_front.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="cover_front_joint" type="revolute">
    <parent link="base" />
    <child link="cover_front" />
    <origin rpy="0 0 0" xyz="0.02510000 0.05970000 0.00680000" />
    <axis xyz="0.00000000 1.00000000 0.00000000" />
    <limit lower="0.000000" upper="3.140000" effort="10" velocity="1" />
  </joint>
</robot>